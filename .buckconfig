# When a project includes this repository as a cell, only [cell_aliases]
# applies; that project declares the cells (see README.md).
[cells]
rust = .
prelude = prelude
toolchains = cells/toolchains
none = none

[external_cells]
prelude = bundled

[cell_aliases]
config = prelude
fbcode = none
fbsource = none

[buck2]
digest_algorithms = SHA256

[project]
# rust/ holds the source checkout for `reindeer buckify`.
ignore = .git, rust

[build]
execution_platforms = rust//platforms:execution
