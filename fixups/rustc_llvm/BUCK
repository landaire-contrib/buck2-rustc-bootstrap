load(
    ":defs.bzl",
    "llvm_config",
    "llvm_cxx_flags",
    "llvm_install",
    "llvm_linker_flags",
    "llvm_preprocessor_flags",
    "llvm_rustc_flags",
)

llvm_install(
    name = "llvm-install",
    llvm = "//stage0:ci_llvm",
)

llvm_config(
    name = "llvm-config",
    llvm = ":llvm-install",
)

llvm_rustc_flags(
    name = "rustc-flags",
    host_llvm_config = ":llvm-config",
    visibility = ["//:rustc_llvm"],
)

llvm_cxx_flags(
    name = "cxx-flags",
    host_llvm_config = ":llvm-config",
    visibility = ["//:rustc_llvm-0.0.0-llvm-wrapper-compile"],
)

llvm_preprocessor_flags(
    name = "preprocessor-flags",
    host_llvm_config = ":llvm-config",
    visibility = ["//:rustc_llvm-0.0.0-llvm-wrapper-compile"],
)

llvm_linker_flags(
    name = "linker-flags",
    host_llvm_config = ":llvm-config",
    target_llvm = ":llvm-install",
)

prebuilt_cxx_library(
    name = "llvm",
    exported_linker_flags = [
        "-L$(location :llvm-install)/lib",
        "-lz",
        "@$(location :linker-flags)",
    ],
    visibility = ["//:rustc_llvm-0.0.0-llvm-wrapper-compile"],
)
