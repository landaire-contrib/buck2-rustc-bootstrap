load("//constraints:defs.bzl", "configuration_transition")
load("//toolchains:cxx.bzl", "msvc_tools")

# Transition to share identical C++ compilations between stage1 and stage2.
configuration_transition(
    name = "prune_cxx_configuration",
    discard_settings = [
        "//constraints:bootstrap-stage",
        "//constraints:build-script",
        "//constraints:workspace",
    ],
)

prebuilt_cxx_library(
    name = "stdlib",
    default_target_platform = "//platforms:host",
    exported_linker_flags = select({
        "DEFAULT": None,
        "prelude//os:linux": ["-lstdc++"],
        "prelude//os:macos": ["-lc++"],
    }),
    visibility = ["PUBLIC"],
)

python_bootstrap_binary(
    name = "flatten_argsfiles",
    main = "flatten_argsfiles.py",
)

msvc_tools(
    name = "msvc_tools",
    target_compatible_with = ["prelude//os:windows"],
    visibility = ["//toolchains:cxx"],
)
