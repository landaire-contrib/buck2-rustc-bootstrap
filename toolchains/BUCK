load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")
load("//keep:defs.bzl", "keep")
load(":cxx.bzl", "cxx_toolchain")
load(":python.bzl", "python_bootstrap_toolchain")
load(":rust.bzl", "rust_toolchain")

# The toolchains of this cell's configurations. A standalone build reaches
# them through the toolchains cell in cells/toolchains; a parent project's
# toolchains cell forwards to them for configurations that have
# //constraints:bootstrap=true.

python_bootstrap_toolchain(
    name = "python_bootstrap",
    visibility = ["PUBLIC"],
)

cxx_toolchain(
    name = "cxx",
    c_flags = select({
        "DEFAULT": [],
        "prelude//os:macos": [
            "-isysroot",
            "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk",
        ],
    }) + select({
        "DEFAULT": [],
        "//constraints:opt-level=0": ["-O0"],
        "//constraints:opt-level=3": ["-O3"],
    }),
    cxx_flags = select({
        "DEFAULT": [],
        "prelude//os:linux": ["-stdlib=libstdc++"],
        "prelude//os:macos": [
            "-isysroot",
            "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk",
        ],
    }) + select({
        "DEFAULT": [],
        "//constraints:opt-level=0": ["-O0"],
        "//constraints:opt-level=3": ["-O3"],
    }),
    linker_flags = select({
        "DEFAULT": [],
        "prelude//os:linux": ["-Wl,--undefined-version"],
    }),
    visibility = ["PUBLIC"],
)

rust_toolchain(
    name = "rust",
    clippy_driver = select({
        "//constraints:stage1": "//stage0:clippy-driver",
        "//constraints:stage2": "//stage1:clippy-driver",
    }),
    compiler = select({
        "//constraints:stage1": select({
            "//constraints:compiler": "//stage0:rustc",
            "//constraints:library-build-script": "//stage0:rustc",
            "//constraints:library": keep("//stage1:rustc"),
        }),
        "//constraints:stage2": select({
            "//constraints:compiler": keep("//stage1:rustc"),
            "//constraints:library-build-script": keep("//stage1:rustc"),
            "//constraints:library": keep("//stage2:rustc"),
        }),
    }),
    exec_compatible_with = [
        "//constraints:opt-level=0",
        "//constraints:build-script=true",
        select({
            "//constraints:compiler": "//constraints:compiler",
            "//constraints:library": "//constraints:library",
        }),
        select({
            "//constraints:stage1": "//constraints:stage1",
            "//constraints:stage2": "//constraints:stage2",
        }),
    ],
    keep = {
        "stage1": "//keep:stage1",
        "stage2": "//keep:stage2",
    },
    rustc_flags = [
        "-Zunstable-options",
        select({
            "//constraints:opt-level=0": "-Copt-level=0",
            "//constraints:opt-level=3": "-Copt-level=3",
        }),
    ] + select({
        "//constraints:stage1": select({
            "//constraints:compiler": ["--cfg=bootstrap"],
            "//constraints:library": [],
        }),
        "//constraints:stage2": [],
    }),
    rustdoc = select({
        "//constraints:stage1": "//stage0:rustdoc",
        "//constraints:stage2": "//stage1:rustdoc",
    }),
    sysroot = select({
        "//constraints:library": None,
        "//constraints:library-build-script": select({
            "//constraints:stage1": "//stage0:sysroot",
            "//constraints:stage2": dict(
                alloc = keep("//stage1:alloc"),
                compiler_builtins = keep("//stage1:compiler_builtins"),
                core = keep("//stage1:core"),
                panic_abort = keep("//stage1:panic_abort"),
                panic_unwind = keep("//stage1:panic_unwind"),
                proc_macro = keep("//stage1:proc_macro"),
                std = keep("//stage1:std"),
                test = keep("//stage1:test"),
            ),
        }),
        "//constraints:compiler": select({
            "//constraints:stage1": "//stage0:sysroot",
            "//constraints:stage2": dict(
                alloc = keep("//stage1:alloc"),
                compiler_builtins = keep("//stage1:compiler_builtins"),
                core = keep("//stage1:core"),
                panic_abort = keep("//stage1:panic_abort"),
                panic_unwind = keep("//stage1:panic_unwind"),
                proc_macro = keep("//stage1:proc_macro"),
                std = keep("//stage1:std"),
                test = keep("//stage1:test"),
            ),
        }),
    }),
    visibility = ["PUBLIC"],
)

noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)
